# Loong OS: 思源黑体（Noto Sans CJK SC）子集，替代镜像里 88 MB 的 font-noto-cjk
# 构建: tools/build-pkg.sh font-noto-sans-sc-loong
#
# 来源是上游 noto-cjk 仓库 Sans2.004 标签里的简体中文可变字体（CFF2，字重 100–900），
# 由 build-font.py 裁剪：GB2312 ∪《通用规范汉字表》8105 字 ∪ 拉丁、标点与常用符号，
# 字重轴 400–700，约 4.2 MiB（Regular + Bold 两个静态子集是 4.5 MiB）。
# 字体族名改为 “Noto Sans CJK SC”，与 font-noto-cjk 一致，loong-ui 与 LoongKit 都不用改。
# 繁体、日文汉字等不在子集里的字：fontconfig 回退到霞鹜文楷（收录约 1.2 万汉字），再没有就显示豆腐块。
pkgname=font-noto-sans-sc-loong
pkgver=2.004
_unihan=17.0.0
pkgrel=0
pkgdesc="Noto Sans CJK SC variable font, subset to GB2312 + Table of General Standard Chinese Characters"
url="https://github.com/notofonts/noto-cjk"
arch="noarch"
license="OFL-1.1"
depends="fontconfig"
makedepends="python3 py3-fonttools"
source="NotoSansSC-VF-$pkgver.otf::https://raw.githubusercontent.com/notofonts/noto-cjk/Sans$pkgver/Sans/Variable/OTF/Subset/NotoSansSC-VF.otf
	noto-cjk-LICENSE-$pkgver::https://raw.githubusercontent.com/notofonts/noto-cjk/Sans$pkgver/LICENSE
	Unihan-$_unihan.zip::https://www.unicode.org/Public/$_unihan/ucd/Unihan.zip
	build-font.py
	65-loong-noto-sans-sc.conf
	"
builddir="$srcdir"
# 纯数据包，没有可运行的测试；构建脚本会打印覆盖率并检查汉字齐全。
options="!check"

build() {
	python3 -I "$srcdir"/build-font.py "$srcdir"/NotoSansSC-VF-$pkgver.otf \
		"$srcdir"/Unihan_OtherMappings.txt "$srcdir"/NotoSansCJKSC-Loong.otf
}

package() {
	install -Dm644 "$srcdir"/NotoSansCJKSC-Loong.otf "$pkgdir"/usr/share/fonts/noto/NotoSansCJKSC-Loong.otf
	install -Dm644 "$srcdir"/noto-cjk-LICENSE-$pkgver "$pkgdir"/usr/share/licenses/$pkgname/LICENSE
	# 思源黑体的其他名字（Noto Sans SC、Source Han Sans SC、思源黑体）强别名到这个字体
	install -Dm644 "$srcdir"/65-loong-noto-sans-sc.conf \
		"$pkgdir"/usr/share/fontconfig/conf.avail/65-loong-noto-sans-sc.conf
	mkdir -p "$pkgdir"/etc/fonts/conf.d
	ln -s /usr/share/fontconfig/conf.avail/65-loong-noto-sans-sc.conf "$pkgdir"/etc/fonts/conf.d/
}

sha512sums="
