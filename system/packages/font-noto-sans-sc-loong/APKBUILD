53cf33ddac5d44b9f622a041f267bcf53ca704555f0481ee3e89eeba505019c8d1d504a6ffe7ebd6a7d1d5d7d26cf3da052cc63b3540eb4260ce74a93cf35841  noto-cjk-LICENSE-2.004
8b0d117fed39600c62864dd0c955b2fe0a52cfc975288fcf58cb770aaf476355f52b2a603e11330184a07d89c705c0fea55eeb9a044c8f1ba3ba79f5f32d0b33  Unihan-17.0.0.zip
c53f8680240eb9a1c8cc372d269a9c041ecc1e2addbeffa2cccfb31b9049d1171b35a0f62e71aa1075eaa49869dab949ecca068b00ab26a63c806239a3a7149f  build-font.py
